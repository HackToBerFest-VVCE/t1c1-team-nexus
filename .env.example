# =====================================================================
# AccidentGuard environment variables — EXAMPLE ONLY
# =====================================================================
# Copy this file to ".env" and fill in your real key:
#     cp .env.example .env        (macOS/Linux)
#     copy .env.example .env     (Windows)
#
# Get a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
#
# NEVER commit the real .env file. It is listed in .gitignore on purpose.
# Never share this key in screenshots, chats, logs, or the README.
# =====================================================================

# Your Google Gemini API key (works for hosted Gemma 4 models).
# Leave blank to run the app in non-AI fallback mode for demo continuity.
GEMINI_API_KEY=

# Gemma 4 model ID to use. Verified supported values (see README):
#   gemma-4-26b-a4b-it   (preferred)
#   gemma-4-31b-it       (fallback)
GEMMA_MODEL_ID=gemma-4-26b-a4b-it

# Optional: request timeout in seconds for the Gemma API call.
GEMMA_TIMEOUT=30

# Flask settings
FLASK_PORT=5000
FLASK_DEBUG=True
